# Copiez ce fichier en .env.local et renseignez les valeurs.
# .env.local est ignoré par git : aucune clé réelle ne doit être committée.

# URL publique du site, utilisée pour metadataBase, le sitemap et les
# métadonnées Open Graph.
NEXT_PUBLIC_SITE_URL=https://astrastudio.pro

# Clé d'accès Web3Forms du formulaire de contact.
#
# Elle est PUBLIQUE par conception : le site est un export statique, il n'a
# aucun serveur pour cacher une clé, et Web3Forms attend justement cette
# valeur côté navigateur (leur filtrage anti-spam est côté serveur, indexé
# sur cette clé). Ce n'est pas un secret d'API — mais elle reste hors du
# dépôt pour que chaque environnement utilise la sienne.
#
# En CI, elle est fournie par le secret GitHub du même nom.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
