# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real secrets.

# Production origin, used to build canonical URLs, the sitemap, robots.txt,
# Open Graph and JSON-LD. Falls back to http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=https://astra-studio.fr

# Web3Forms (https://web3forms.com) access key used to send contact-form
# submissions directly from the browser — required because this site ships
# as a static export (output: "export", for OVH's static hosting), which
# has no server left to run an API route or hide a real secret behind.
# Get a free key at https://web3forms.com (just an email address, no signup)
# and set the mailbox that should receive submissions there, not here.
# Without this variable, the form says so honestly instead of faking a
# success message.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
