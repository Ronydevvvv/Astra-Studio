# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real secrets.

# Production origin, used to build canonical URLs, the sitemap, robots.txt,
# Open Graph and JSON-LD. Falls back to http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=https://astra-studio.fr

# Resend (https://resend.com) API key used to send contact-form submissions.
# Without it, /api/contact answers "not_configured" and the form says so
# honestly instead of faking a success message.
RESEND_API_KEY=

# The mailbox that should receive contact-form submissions.
CONTACT_EMAIL=
